{
  "name": "hkia-save-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && vite build",
    "test:wasm": "node scripts/wasm-smoke.mjs",
    "assets:original-colorways": "node scripts/unpack-source-colorways.mjs",
    "predev": "npm run assets:original-colorways && npm run assets:native-art",
    "pretest": "npm run assets:original-colorways && npm run assets:native-art",
    "prebuild": "npm run assets:original-colorways && npm run assets:native-art",
    "assets:native-art": "node scripts/unpack-native-art.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
